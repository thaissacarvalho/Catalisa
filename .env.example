# Required to start the application
DB_HOST=localhost
DB_PORT=5432
DB_NAME=token
DB_USERNAME=token
DB_PASSWORD=

# Generate a random secret with at least 32 bytes; never commit its real value.
JWT_SECRET=
# Gere openssl rand -hex 32

# Optional overrides (these values have defaults in the application)
NODE_ENV=development
APP_HOST=0.0.0.0
APP_PORT=3000
JWT_EXPIRES_IN_SECONDS=28800
JWT_ISSUER=token-api
JWT_AUDIENCE=token-admin

# Required only when creating the initial superadmin
INITIAL_SUPER_ADMIN_NAME=Token Administrator
INITIAL_SUPER_ADMIN_EMAIL=admin@example.com
INITIAL_SUPER_ADMIN_JOB_POSITION=Administrator
INITIAL_SUPER_ADMIN_ENTERPRISE=Token
INITIAL_SUPER_ADMIN_PASSWORD=Admin@Token999
