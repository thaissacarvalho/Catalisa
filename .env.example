# Obrigatórias para a conexão com PostgreSQL
DB_HOST=localhost
DB_PORT=5432
DB_NAME=catalisa
DB_USERNAME=catalisa
DB_PASSWORD=

# Gere um segredo aleatório de pelo menos 32 bytes (ex.: openssl rand -hex 32).
JWT_SECRET=

# Opcionais (a aplicação já define estes valores)
NODE_ENV=development
APP_HOST=0.0.0.0
APP_PORT=3000
JWT_EXPIRES_IN_SECONDS=28800
JWT_ISSUER=catalisa-api
JWT_AUDIENCE=catalisa-admin

# Preencha ao criar o primeiro SUPER_ADMIN
INITIAL_SUPER_ADMIN_NAME=Administrador CATALISA
INITIAL_SUPER_ADMIN_EMAIL=admin@example.com
INITIAL_SUPER_ADMIN_JOB_POSITION=Administrator
INITIAL_SUPER_ADMIN_ENTERPRISE=CATALISA
INITIAL_SUPER_ADMIN_PASSWORD=
