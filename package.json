{
  "name": "catalisa-back-end",
  "version": "2.0.0",
  "main": "dist/main.js",
  "scripts": {
    "build": "nest build",
    "start": "node dist/main.js",
    "start:dev": "nest start --watch",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write \"src/**/*.ts\" \"migrations/**/*.ts\" \"seeders/**/*.ts\"",
    "format:check": "prettier --check \"src/**/*.ts\" \"migrations/**/*.ts\" \"seeders/**/*.ts\"",
    "lint": "eslint \"{src,migrations,seeders}/**/*.ts\"",
    "lint:fix": "eslint \"{src,migrations,seeders}/**/*.ts\" --fix",
    "admin:bootstrap": "node -r ts-node/register -r tsconfig-paths/register scripts/bootstrap-initial-super-admin.ts",
    "db:migrate": "sequelize-cli db:migrate",
    "db:migrate:undo": "sequelize-cli db:migrate:undo",
    "db:migrate:status": "sequelize-cli db:migrate:status",
    "db:seed": "sequelize-cli db:seed:all",
    "db:seed:undo": "sequelize-cli db:seed:undo",
    "db:seed:status": "sequelize-cli db:seed:status"
  },
  "keywords": [],
  "author": "Thaissa Carvalho",
  "license": "ISC",
  "description": "",
  "dependencies": {
    "@nestjs/common": "^11.1.29",
    "@nestjs/core": "^11.1.29",
    "@nestjs/jwt": "^11.0.2",
    "@nestjs/platform-express": "^11.1.29",
    "@nestjs/swagger": "^11.4.7",
    "axios": "^1.19.0",
    "bcrypt": "6.0.0",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.15.1",
    "dotenv": "^17.4.2",
    "env-var": "^7.5.0",
    "express": "^5.2.1",
    "pg": "^8.23.0",
    "pg-hstore": "^2.3.4",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "sequelize": "^6.37.8",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "4.2.0",
    "uuid": "^14.0.1"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@nestjs/cli": "^11.0.24",
    "@nestjs/schematics": "^11.1.0",
    "@types/bcrypt": "^6.0.0",
    "@types/node": "^26.2.0",
    "eslint": "10.9.1",
    "eslint-config-prettier": "10.1.8",
    "globals": "17.11.0",
    "nodemon": "^3.1.14",
    "prettier": "3.8.2",
    "sequelize-cli": "^6.6.5",
    "typescript": "^6.0.3",
    "typescript-eslint": "8.68.0"
  }
}